[
  {
    "id": "git_repos",
    "name": "Git repos",
    "kind": "files",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "state": "supported",
    "blurb": "branch switches and commits, polled every 60 s per watched repo",
    "probes": [
      {
        "probe": "config",
        "field": "git_repos",
        "platforms": []
      },
      {
        "probe": "command",
        "cmd": "git",
        "platforms": []
      }
    ],
    "produces": [
      "checkout",
      "commit"
    ],
    "setup": [
      {
        "step": "field",
        "field": "git_repos",
        "hint": "repo paths, ~ expanded; repo discovery fills this in for you"
      }
    ],
    "docs": "git"
  },
