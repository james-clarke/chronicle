# Constrains derivation output to the interval JSON schema (derive v3).
# Containment layer for untrusted title/MCP text: the model can only emit this
# shape. ref = index into the digest's numbered "## Open tasks" list
# (deterministic linking); ref null proposes a new task via label.
# "ref null => label required" is enforced in code, not here.
# Bounded repetition (x{0,N}) only — chained x? x? is pathologically slow.

root ::= "{" ws "\"intervals\"" ws ":" ws "[" ws (interval (ws "," ws interval){0,11})? ws "]" ws "}"

# One line on purpose: llama.cpp's GBNF parser ends a rule at newline
# (continuations are only legal inside parentheses).
interval ::= "{" ws "\"ref\"" ws ":" ws (int | "null") ws "," ws "\"label\"" ws ":" ws (string | "null") ws "," ws "\"project\"" ws ":" ws (string | "null") ws "," ws "\"start_offset_min\"" ws ":" ws int ws "," ws "\"end_offset_min\"" ws ":" ws int ws "," ws "\"confidence\"" ws ":" ws confidence ws "}"

string ::= "\"" char{0,120} "\""
char ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
int ::= [0-9]{1,4}
confidence ::= ("0" | "1") ("." [0-9]{1,3})?
ws ::= [ \n\t]{0,4}
