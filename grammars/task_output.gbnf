# Constrains derivation output to the task JSON schema. Containment layer for
# untrusted title/MCP text: the model can only emit this shape.
# Bounded repetition (x{0,N}) only — chained x? x? is pathologically slow.

root ::= "{" ws "\"tasks\"" ws ":" ws "[" ws (task (ws "," ws task){0,7})? ws "]" ws "}"

task ::= "{" ws "\"label\"" ws ":" ws string ws ","
             ws "\"project\"" ws ":" ws (string | "null") ws ","
             ws "\"start_offset_min\"" ws ":" ws int ws ","
             ws "\"end_offset_min\"" ws ":" ws int ws ","
             ws "\"confidence\"" ws ":" ws confidence ws "}"

string ::= "\"" char{0,120} "\""
char ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4})
int ::= [0-9]{1,4}
confidence ::= ("0" | "1") ("." [0-9]{1,3})?
ws ::= [ \n\t]{0,4}
